# Public browser configuration. NEXT_PUBLIC_ variables are visible in the rendered page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-supabase-anon-key

# Server-side public data reads. No private key is needed for page rendering.
SUPABASE_URL=https://your-project.supabase.co
# Only needed if OTP lead verification or blog comments are enabled:
# SUPABASE_SERVICE_ROLE_KEY=your-private-supabase-service-role-key

# Server-only MSG91 OTP configuration.
MSG91_AUTH_KEY=your-private-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# Server-only CRM webhook. Verified leads are posted here after OTP succeeds.
CRM_WEBHOOK_URL=https://your-crm.example.com/webhooks/leads
# Optional bearer token sent to the CRM webhook.
CRM_WEBHOOK_AUTH_TOKEN=your-private-crm-webhook-token

# Cloudflare Turnstile widget keys (the site key is public; the secret is server-only).
TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
